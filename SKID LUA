-- --- FLIGHT CORE SUB-ROUTINE ---
local flyBv = Instance.new("BodyVelocity")
local flyBg = Instance.new("BodyGyro")

RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    local rootPart = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
    local hum = char and char:FindFirstChild("Humanoid") :: Humanoid?
    
    if rootPart and hum and Config.FlyEnabled then
        flyBg.Parent = rootPart
        flyBv.Parent = rootPart
        
        flyBg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
        flyBg.cframe = Camera.CFrame
        
        flyBv.maxForce = Vector3.new(9e9, 9e9, 9e9)
        
        local direction = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then direction = direction + Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then direction = direction - Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then direction = direction - Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then direction = direction + Camera.CFrame.RightVector end
        
        flyBv.velocity = direction * Config.FlySpeed
        hum.PlatformStand = true
    else
        flyBv.Parent = nil
        flyBg.Parent = nil
        if hum then hum.PlatformStand = false end
    end
end)

-- --- CTRL + CLICK TP SUB-ROUTINE ---
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.UserInputType == Enum.UserInputType.MouseButton1 and Config.ClickTPEnabled then
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) and Mouse.Hit then
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
            if root then
                root.CFrame = CFrame.new(Mouse.Hit.Position + Vector3.new(0, 3, 0))
            end
        end
    end
end)

-- --- CHAMS VISUAL ENGINE ---
local function applyChams(player: Player)
    local function highlightCharacter(char: Model)
        local highlight = char:FindFirstChild("AdminCham") :: Highlight?
        if not highlight then
            highlight = Instance.new("Highlight")
            highlight.Name = "AdminCham"
            highlight.FillColor = Color3.fromRGB(239, 68, 68)
            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            highlight.FillOpacity = 0.5
            highlight.OutlineOpacity = 0.2
            highlight.Adornee = char
            highlight.Parent = char
        end
        
        RunService.RenderStepped:Connect(function()
            if char and char.Parent and highlight then
                highlight.Enabled = Config.ChamsEnabled
            elseif highlight then
                highlight:Destroy()
            end
        end)
    end
    
    if player.Character then highlightCharacter(player.Character) end
    player.CharacterAdded:Connect(highlightCharacter)
end

for _, p in Players:GetPlayers() do
    if p ~= LocalPlayer then applyChams(p) end
end
Players.PlayerAdded:Connect(applyChams)


