            if root then
                root.CFrame = CFrame.new(Mouse.Hit.Position + Vector3.new(0, 3, 0))
            end
        end
    end
end)

-- --- CHAMS VISUAL ENGINE ---
local function applyChams(player: Player)
    local function highlightCharacter(char: Model)
        local highlight = char:FindFirstChild("AdminCham") :: Highlight?
        if not highlight then
            highlight = Instance.new("Highlight")
            highlight.Name = "AdminCham"
            highlight.FillColor = Color3.fromRGB(239, 68, 68)
            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            highlight.FillOpacity = 0.5
            highlight.OutlineOpacity = 0.2
            highlight.Adornee = char
            highlight.Parent = char
        end
        
        RunService.RenderStepped:Connect(function()
            if char and char.Parent and highlight then
                highlight.Enabled = Config.ChamsEnabled
            elseif highlight then
                highlight:Destroy()
            end
        end)
    end
    
    if player.Character then highlightCharacter(player.Character) end
    player.CharacterAdded:Connect(highlightCharacter)
end

for _, p in Players:GetPlayers() do
    if p ~= LocalPlayer then applyChams(p) end
end
Players.PlayerAdded:Connect(applyChams)


