-- --- FLIGHT CORE SUB-ROUTINE ---
local flyBv = Instance.new("BodyVelocity")
local flyBg = Instance.new("BodyGyro")

RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    local rootPart = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
    local hum = char and char:FindFirstChild("Humanoid") :: Humanoid?
    
    if rootPart and hum and Config.FlyEnabled then
        flyBg.Parent = rootPart
        flyBv.Parent = rootPart
        
        flyBg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
        flyBg.cframe = Camera.CFrame
        
        flyBv.maxForce = Vector3.new(9e9, 9e9, 9e9)
        
        local direction = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then direction = direction + Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then direction = direction - Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then direction = direction - Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then direction = direction + Camera.CFrame.RightVector end
        
        flyBv.velocity = direction * Config.FlySpeed
        hum.PlatformStand = true
    else
        flyBv.Parent = nil
        flyBg.Parent = nil
        if hum then hum.PlatformStand = false end
    end
end)

-- --- CTRL + CLICK TP SUB-ROUTINE ---
UserInputService.InputBegan:Connect(function(input, gameProcessed)
