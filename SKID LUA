--!strict
-- EXECUTOR-COMPATIBLE LIVE TELEPORT PANEL (RAYFIELD EDITION)
-- UPDATE YOUR GITHUB FILE WITH THIS ENTIRE SCRIPT BLOCK

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Yield setup to ensure your local player environment is fully ready
if not LocalPlayer then
    LocalPlayer = Players:GetPropertyChangedSignal("LocalPlayer"):Wait() or Players.LocalPlayer
end

-- Active session memory coordinate storage
local MarkedPosition: Vector3? = nil

-- 1. Initialize Rayfield UI Library Framework (Official Sirius Source Link)
local Rayfield = loadstring(game:HttpGet('https://raw.githubusercontent.com/SiriusSoftwareLtd/Rayfield/main/source.lua'))()

local Window = Rayfield:CreateWindow({
   Name = "Universal Teleport Panel",
   Icon = 0,
   LoadingTitle = "Loading Environment Engine...",
   LoadingSubtitle = "by Jayden",
   Theme = "Default", -- "Default", "Amber", "Amethyst", "Green" etc.
   ConfigurationSaving = {
      Enabled = false
   },
   Discord = {
      Enabled = false
   },
   KeySystem = false -- Disabled to ensure instant execution without keys
})

-- 2. Create the System Management Tab
local TeleportTab = Window:CreateTab("⚡ Teleport Engine", nil) -- Title, Image

-- 3. Element Interfaces: Position Management
TeleportTab:CreateButton({
   Name = "📍 Mark Current Location",
   Callback = function()
        local character = LocalPlayer.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
        
        if rootPart then
            MarkedPosition = rootPart.Position
            Rayfield:Notify({
               Title = "Position Recorded",
               Content = string.format("Coordinates successfully mapped at: %.1f, %.1f, %.1f", MarkedPosition.X, MarkedPosition.Y, MarkedPosition.Z),
               Duration = 3,
               Image = nil,
            })
        else
            Rayfield:Notify({
               Title = "Mapping Error",
               Content = "Could not locate your Character's Root Part. Stand still and retry.",
               Duration = 3,
               Image = nil,
            })
        end
   end,
})

TeleportTab:CreateButton({
   Name = "⚡ Teleport To Marked Spot",
   Callback = function()
        local character = LocalPlayer.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
        
        if rootPart and MarkedPosition then
            -- Instantly alters CFrame coordinates relative to client-side physics replication rules
            rootPart.CFrame = CFrame.new(MarkedPosition + Vector3.new(0, 0.5, 0))
            
            Rayfield:Notify({
               Title = "Teleport Successful",
               Content = "Snapped instantly to your active checkpoint.",
               Duration = 2,
               Image = nil,
            })
        else
            Rayfield:Notify({
               Title = "Execution Halted",
               Content = "No marked location found in active memory cache! Tap Mark Location first.",
               Duration = 4,
               Image = nil,
            })
        end
   end,
})

-- 4. Information Segment Layout
local InfoSection = TeleportTab:CreateSection("System Analytics")

TeleportTab:CreateParagraph({
    Title = "💡 How to operate:",
    Content = "1. Walk to your desired location.\n2. Tap 'Mark Current Location'.\n3. Walk anywhere else on the map.\n4. Tap 'Teleport To Marked Spot' to warp back instantly."
})
